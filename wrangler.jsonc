{
  "name": "willfit-media",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 5 * * SUN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "willfit-media",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
